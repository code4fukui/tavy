{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read=public,migrations,data --allow-write=data --allow-env=TAVY_DB,TAVY_PORT,TAVY_SECURE_COOKIE src/server.ts",
    "start": "deno run --allow-net --allow-read=public,migrations,data --allow-write=data --allow-env=TAVY_DB,TAVY_PORT,TAVY_SECURE_COOKIE src/server.ts",
    "test": "deno test --allow-read=migrations",
    "check": "deno fmt --check && deno lint && deno check src/server.ts && deno test --allow-read=migrations"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "imports": {
    "qrcode": "npm:qrcode@1.5.4"
  }
}
